{
  "name": "untrace-ai-desktop",
  "version": "1.4.0",
  "description": "Untrace AI Desktop App - AI Watermark Remover",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "ai.untrace.desktop",
    "productName": "Untrace AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "icon.*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "icon.ico",
      "target": ["nsis", "zip"]
    },
    "linux": {
      "icon": "icon.png",
      "target": ["AppImage", "deb"]
    }
  }
}